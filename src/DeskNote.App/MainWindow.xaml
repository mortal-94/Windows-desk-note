<Window x:Class="DeskNote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DeskNote"
        Width="460"
        Height="680"
        MinWidth="280"
        MinHeight="240"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="False"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border x:Name="WindowBorder" BorderThickness="1" BorderBrush="#557A6A35">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderPanel"
                  Grid.Row="0"
                  Height="36"
                  Background="#187A6A35"
                  Visibility="Collapsed"
                  MouseLeftButtonDown="HeaderPanel_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="10,0,6,0" VerticalAlignment="Center" FontSize="16" Text="⋮⋮" ToolTip="拖动窗口" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="DeskNote" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,5,0">
                    <Button Click="Settings_Click" Content="设置" ToolTip="外观、快捷键和备份设置" />
                    <Button Click="Exit_Click" Content="退出" ToolTip="保存并退出" />
                </StackPanel>
            </Grid>

            <Border x:Name="SearchPanel"
                    Grid.Row="1"
                    Padding="7"
                    Background="#16FFFFFF"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             MinWidth="120"
                             Padding="6,4"
                             VerticalContentAlignment="Center"
                             ToolTip="输入要查找的文本"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown" />
                    <Button Grid.Column="1" Click="FindPrevious_Click" Content="↑" ToolTip="查找上一个（Shift+Enter）" />
                    <Button Grid.Column="2" Click="FindNext_Click" Content="↓" ToolTip="查找下一个（Enter）" />
                    <CheckBox x:Name="MatchCaseCheckBox"
                              Grid.Column="3"
                              Margin="8,0"
                              VerticalAlignment="Center"
                              Checked="MatchCase_Changed"
                              Unchecked="MatchCase_Changed"
                              Content="区分大小写" />
                    <Button Grid.Column="4" Click="CloseSearch_Click" Content="×" ToolTip="关闭搜索（Esc）" />
                </Grid>
            </Border>

            <TextBox x:Name="NoteEditor"
                     Grid.Row="2"
                     Margin="10,6"
                     Padding="4"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     AllowDrop="False"
                     BorderThickness="0"
                     HorizontalScrollBarVisibility="Disabled"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     SpellCheck.IsEnabled="False"
                     TextBlock.LineStackingStrategy="BlockLineHeight"
                     TextChanged="NoteEditor_TextChanged"
                     PreviewTextInput="NoteEditor_PreviewTextInput"
                     LostKeyboardFocus="NoteEditor_LostKeyboardFocus"
                     PreviewMouseLeftButtonDown="NoteEditor_PreviewMouseLeftButtonDown"
                     ToolTip="非空行自动成为待办项；点击行首方框切换完成状态"
                     AutomationProperties.Name="单页笔记编辑区">
                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="ApplicationCommands.Undo" Header="撤销" InputGestureText="Ctrl+Z" />
                        <MenuItem Command="ApplicationCommands.Redo" Header="重做" InputGestureText="Ctrl+Y" />
                        <Separator />
                        <MenuItem Command="ApplicationCommands.Cut" Header="剪切" InputGestureText="Ctrl+X" />
                        <MenuItem Command="ApplicationCommands.Copy" Header="复制" InputGestureText="Ctrl+C" />
                        <MenuItem Command="ApplicationCommands.Paste" Header="粘贴" InputGestureText="Ctrl+V" />
                        <Separator />
                        <MenuItem Click="Settings_Click" Header="设置…" />
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>

            <Grid x:Name="FooterPanel" Grid.Row="3" Margin="10,3,10,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="正在编辑" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.72" Text="Esc / 快捷键：保存并回到桌面" />
            </Grid>
        </Grid>
    </Border>
</Window>
