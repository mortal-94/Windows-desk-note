<Window x:Class="DeskNote.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskNote 设置"
        Width="480"
        SizeToContent="Height"
        MaxHeight="760"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="128" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12" FontSize="17" FontWeight="SemiBold" Text="外观与行为" />

        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="全局快捷键" />
        <TextBox x:Name="HotkeyBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="6,4" ToolTip="例如 Ctrl+Alt+N" />

        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="字体" />
        <ComboBox x:Name="FontFamilyBox" Grid.Row="2" Grid.Column="1" Margin="0,4" IsEditable="True" />

        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="字号（10–72）" />
        <TextBox x:Name="FontSizeBox" Grid.Row="3" Grid.Column="1" Margin="0,4" Padding="6,4" />

        <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="行距倍数（1–2.5）" />
        <TextBox x:Name="LineSpacingBox" Grid.Row="4" Grid.Column="1" Margin="0,4" Padding="6,4" />

        <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="背景色" />
        <TextBox x:Name="BackgroundBox" Grid.Row="5" Grid.Column="1" Margin="0,4" Padding="6,4" ToolTip="#RRGGBB 或 #AARRGGBB" />

        <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="文字颜色" />
        <TextBox x:Name="ForegroundBox" Grid.Row="6" Grid.Column="1" Margin="0,4" Padding="6,4" ToolTip="#RRGGBB 或 #AARRGGBB" />

        <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="窗口不透明度" />
        <Grid Grid.Row="7" Grid.Column="1" Margin="0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="45" /></Grid.ColumnDefinitions>
            <Slider x:Name="OpacitySlider" Minimum="45" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OpacitySlider_ValueChanged" />
            <TextBlock x:Name="OpacityValue" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="自动保存延迟（秒）" />
        <TextBox x:Name="AutoSaveBox" Grid.Row="8" Grid.Column="1" Margin="0,4" Padding="6,4" />

        <TextBlock Grid.Row="9" VerticalAlignment="Center" Text="备份份数（1–20）" />
        <TextBox x:Name="BackupCountBox" Grid.Row="9" Grid.Column="1" Margin="0,4" Padding="6,4" />

        <Border Grid.Row="10" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="10" Background="#FFF5F5F5">
            <DockPanel>
                <Button DockPanel.Dock="Right" Click="OpenDataFolder_Click" Content="打开数据目录" />
                <TextBlock VerticalAlignment="Center" Text="内容始终保存为可直接恢复的 UTF-8 文本。" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="80" IsDefault="True" Click="Save_Click" Content="保存" />
            <Button MinWidth="80" IsCancel="True" Content="取消" />
        </StackPanel>
    </Grid>
</Window>
